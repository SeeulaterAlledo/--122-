<Window x:Class="MathFunctionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа 1" Height="400" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Изображение формулы -->
        <Image Source="image.png" Height="80" HorizontalAlignment="Center" ToolTip="Математическая формула"/>

        <!-- Ввод x и b -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="x:"/>
            <TextBox x:Name="InputX" Width="80" ToolTip="Введите значение x"/>
            <Label Content="b:"/>
            <TextBox x:Name="InputB" Width="80" ToolTip="Введите значение b"/>
        </StackPanel>

        <!-- Выбор функции f(x) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="Функция f(x):"/>
            <RadioButton x:Name="ShX" Content="sh(x)" ToolTip="Гиперболический синус"/>
            <RadioButton x:Name="SquareX" Content="x²" ToolTip="Квадрат числа"/>
            <RadioButton x:Name="ExpX" Content="e^x" ToolTip="Экспонента"/>
        </StackPanel>

        <!-- Вывод результата -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="Результат:"/>
            <TextBox x:Name="OutputResult" Width="200" IsReadOnly="True" ToolTip="Результат вычисления"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CalculateButton" Content="Вычислить" Click="CalculateButton_Click" ToolTip="Рассчитать значение"/>
            <Button x:Name="ClearButton" Content="Очистить" Click="ClearButton_Click" ToolTip="Очистить поля"/>
        </StackPanel>
    </Grid>
</Window>
